# Normalize line endings
* text=auto

# ============================================================
# Packagist export exclusions
# These paths are NOT included in `composer create-project` or
# `composer install` installs — only src/ and config/ ship.
# ============================================================
/workbench            export-ignore
/tests                export-ignore
/laragraph            export-ignore
/bin                  export-ignore
/.github              export-ignore
/phpunit.xml          export-ignore
/phpunit.xml.bak      export-ignore
/build                export-ignore
/composer.lock        export-ignore
/CONTRIBUTING.md      export-ignore
/.gitattributes       export-ignore
/.gitignore           export-ignore
/workbench.json       export-ignore
/src/config           export-ignore
/example              export-ignore
/.editorconfig        export-ignore
/phpstan.neon.dist    export-ignore
/pint.json            export-ignore
/rector.php           export-ignore
/.releaserc.json      export-ignore
/package.json         export-ignore
/package-lock.json    export-ignore
