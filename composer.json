{
    "name": "ayimdomnic/laragraph",
    "description": "GraphQl for Laravel developers",
    "type": "library",
    "require": {
        "php": ">=8.4",
        "ext-json": "*",
        "illuminate/contracts": "^12.20",
        "illuminate/support": "^12.20"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Odhiambo Dormnic",
            "email": "ayimdomnic@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Ayimdomnic\\GraphQl\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ayimdomnic\\GraphQl\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist"
    }
}