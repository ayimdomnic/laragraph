<?php

declare(strict_types=1);

namespace DummyNamespace;

use Ayimdomnic\Laragraph\Exceptions\GraphQLException;

class DummyClass extends GraphQLException
{
    /**
     * @param array<string, mixed> $replace Values substituted into the translated message.
     * @param array<string, mixed> $extra   Extra data merged into the GraphQL error's extensions.
     */
    public function __construct(array $replace = [], array $extra = [])
    {
        parent::__construct(
            key: 'errors.DummyKey',
            errorCode: 'DummyCode',
            replace: $replace,
            extra: $extra,
        );
    }
}
